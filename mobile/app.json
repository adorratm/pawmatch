{
  "expo": {
    "name": "PawMatch",
    "slug": "pawmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#6a3f2a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawmatchmobile.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6a3f2a"
      },
      "package": "com.pawmatchmobile.app"
    },
    "scheme": "pawmatch",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      [
        "react-native-maps",
        {
          "ios": {
            "mapsStyle": "standard"
          },
          "android": {
            "mapsStyle": "standard"
          }
        }
      ]
    ]
  }
}
