# ============================================
# PAWMATCH MOBILE - ENVIRONMENT VARIABLES
# ============================================
# Değerleri doldurduktan sonra Metro'yu yeniden başlatın: yarn start --clear

# ============================================
# API / SOCKET (OPSIYONEL - varsayılan localhost)
# ============================================
# Backend API adresi. Fiziksel cihazda bilgisayarınızın LAN IP'sini kullanın.
# Örnek: EXPO_PUBLIC_API_URL=http://192.168.1.143:3000/api
# Kaynak: mobile-backend sunucunuzun adresi (PORT=3000)
EXPO_PUBLIC_API_URL=

# WebSocket (chat) adresi. API ile aynı host, /api olmadan.
# Örnek: EXPO_PUBLIC_SOCKET_URL=http://192.168.1.143:3000
EXPO_PUBLIC_SOCKET_URL=

# ============================================
# GOOGLE OAUTH (OPSIYONEL)
# ============================================
# Kaynak: https://console.cloud.google.com/ > APIs & Services > Credentials
# OAuth 2.0 Client ID oluşturun (Web, iOS, Android ayrı ayrı).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Kaynak: Google Cloud Console > iOS OAuth Client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Kaynak: Google Cloud Console > Android OAuth Client ID
# Android package name: com.pawmatchmobile.app (app.json ile aynı)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ============================================
# FACEBOOK LOGIN (OPSIYONEL)
# ============================================
# Kaynak: https://developers.facebook.com/ > Uygulamanız > Settings > Basic > App ID
# App Secret mobil .env'e KONMAZ — sadece backend .env'de (FACEBOOK_APP_SECRET).
EXPO_PUBLIC_FACEBOOK_APP_ID=

# ============================================
# REVENUECAT / IAP (OPSIYONEL)
# ============================================
# Kaynak: https://app.revenuecat.com > Projeniz > API Keys
# sandbox = test anahtarları; production = canlı App Store / Play Store
EXPO_PUBLIC_REVENUECAT_KEY_MODE=

# Kaynak: RevenueCat Dashboard > API Keys > iOS (Public SDK Key)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Kaynak: RevenueCat Dashboard > API Keys > Android (Public SDK Key)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# İsteğe bağlı ayrı sandbox projesi anahtarları (KEY_MODE=sandbox iken öncelikli)
# Kaynak: RevenueCat Dashboard > ayrı test projesi > API Keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY_SANDBOX=

# Kaynak: RevenueCat Dashboard > ayrı test projesi > API Keys
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY_SANDBOX=

# Kaynak: RevenueCat Dashboard > Entitlements bölümündeki entitlement identifier
# Varsayılan kod içi fallback: pati_gold
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=

# ============================================
# EXPO / EAS (OPSIYONEL)
# ============================================
# Push token kaydı için. Kaynak: https://expo.dev > Projeniz > Project settings > Project ID
# veya mobile/app.json > extra.eas.projectId
EXPO_PUBLIC_EAS_PROJECT_ID=
